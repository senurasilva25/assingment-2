VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side database connection only. Never prefix this value with VITE_.
DATABASE_URL=
# Optional override; defaults to the included official Supabase root CA.
DATABASE_SSL_CA_PATH=

# Server-only Gemini key. Never use a VITE_ prefix.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
